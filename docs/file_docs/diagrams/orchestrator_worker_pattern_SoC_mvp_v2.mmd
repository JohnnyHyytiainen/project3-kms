        CH["chunker.py<br/>HUR man delar text i bitar<br/>Vet inte ens att PDF finns"]
        PW["parquet_writer.py<br/>HUR man serialiserar till Parquet<br/>Vet inte ens hur en s3_key byggs<br/>Vet inte ens om att ORM-modellen Document finns"]
        S3["s3_client.py<br/>HUR man laddar upp till en bucket<br/>Vet inte ens vad course_tag är"]
    end


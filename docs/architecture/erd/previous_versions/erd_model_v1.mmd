---
config:
  theme: neo-dark
---
erDiagram
    DOCUMENT ||--o{ CHUNK : "contains"

    DOCUMENT {
        int id PK
        string s3_key
        string filename
        string source_type
        string course_tag
        string status
        string file_hash
        string error_message
        timestamp created_at
        timestamp updated_at
    }

    CHUNK {
        int id PK
        int document_id FK
        int chunk_index
        text content
        string vector_id
        jsonb source_location
        int char_count
        timestamp created_at
    }

    USER {
        int id PK
        string api_key_hash
        string label
        boolean is_active
        timestamp created_at
        timestamp last_used_at
    }
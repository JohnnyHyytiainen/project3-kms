    PDF --> ING
    MD --> ING
    TRANS --> ING
    ING --> S3
    ING --> PG1

    S3 --> EXT
    PG1 -. status PENDING .-> EXT
    EXT --> CHUNK
    CHUNK --> PARQUET
    PARQUET -. status uppdateras .-> PG1

    PARQUET --> EMB
    EMB --> CHROMA
    CHROMA -. vector-ID .-> PG1

    CHROMA --> API
    API --> RERANK
    RERANK --> CONF
    CONF -->|Hög| GEN
    CONF -->|Lågt, första försök| REFORM
    REFORM --> RERANK
    CONF -->|Lågt, redan försökt| HONEST
    GEN --> SRC

    EVAL -. mäter .-> API

    PG1 --> AIRFLOW
    S3 --> AIRFLOW
    PG1 --> DBT

    API --> CD
    CD --> PROXY